# Edge Function Environment Variables Example
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Note: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are automatically
# available in deployed edge functions via Supabase secrets.
# These env vars are only needed for local development.
